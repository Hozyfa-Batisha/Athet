NODE_ENV=production
PORT=3000
HOST=0.0.0.0
PUBLIC_URL=https://your-domain.example
COOKIE_SECURE=true
DATABASE_URL=postgresql://athar:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:5432/athar
DATABASE_SSL=false
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_HEX_PASSWORD
ALLOW_SIGNUP=true
IMPORT_LEGACY_ON_START=true
LEGACY_DATA_DIR=legacy-data
SESSION_HOURS=24
# Optional, disabled unless you configure both variables and request a backup.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
