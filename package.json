{
  "name": "athar-schedule",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Athar scheduling and learning platform with server-side persistence",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node scripts/demo.js",
    "build:css": "tailwindcss -c tailwind.config.cjs -i styles/tailwind.css -o public/styles/tailwind.css --minify",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "import:legacy": "node --env-file-if-exists=.env scripts/import-legacy.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "check": "node scripts/check.js",
    "setup:env": "node scripts/setup-env.js",
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.js"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "prettier": "3.6.2",
    "tailwindcss": "3.4.17",
    "tone": "14.8.49"
  }
}
